**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform plan files
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files can contain sensitive values
*.tfvars
*.tfvars.json

# Allow examples without real secrets
!*.tfvars.example
!*.tfvars.json.example

.terraformrc
terraform.rc

**/.terragrunt-cache/*

# Operating system files
.DS_Store
Thumbs.db